# Copy this file to .env and adjust the values for your machine.
# .env is gitignored. Do not commit real passwords.

APP_NAME=AI Job Application Copilot
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local PostgreSQL URL. Create the database before running migrations.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_job_copilot

# Local Ollama server. The API starts even when Ollama is not running.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Comma-separated browser origins, or a JSON list.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
